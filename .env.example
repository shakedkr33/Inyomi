# ============================================================================
# Environment Variables - Mobile Template
# ============================================================================
# העתק קובץ זה ל-.env והחלף את הערכים שלך
# Copy this file to .env and replace with your values
#
# קובץ .env לא עולה ל-Git (נמצא ב-.gitignore)
# .env files are gitignored for security

# ============================================================================
# Convex (חובה / Required)
# ============================================================================
# נוצר אוטומטית כשמריצים: bunx convex dev
# Auto-generated when running: bunx convex dev

CONVEX_DEPLOYMENT=dev:your-project-name-123
EXPO_PUBLIC_CONVEX_URL=https://your-project-name.convex.cloud

# הערה: Convex יוצר NEXT_PUBLIC_CONVEX_URL אבל האפליקציה משתמשת ב-EXPO_PUBLIC
# Note: Convex creates NEXT_PUBLIC_CONVEX_URL but the app uses EXPO_PUBLIC

# ============================================================================
EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=
# ============================================================================
# נדרש רק אם אתם משתמשים במערכת התשלומים
# Only required if using the payment system
# ראה docs/REVENUECAT_SETUP.md להוראות מלאות

# Test Store API Key (לבדיקות בפיתוח בלבד)
# EXPO_PUBLIC_REVENUECAT_TEST_STORE_API_KEY=test_...

# Production API Keys (לפלטפורמה ספציפית)
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...

# ============================================================================
# Legal URLs - קישורים משפטיים (אופציונלי / Optional)
# ============================================================================
# אם לא מוגדר, ישתמש בברירות מחדל מ-config/legalUrls.ts
# If not set, will use defaults from config/legalUrls.ts

# EXPO_PUBLIC_PRIVACY_POLICY_URL=https://yourdomain.com/privacy
# EXPO_PUBLIC_TERMS_OF_SERVICE_URL=https://yourdomain.com/terms

# ============================================================================
# Google OAuth (העתקת אירועים / Calendar Copy — iOS + Android)
# ============================================================================
# Google OAuth Client IDs (from Google Cloud Console, project inyomi-500406)
# Real values go in .env only — never commit. These are Client IDs, not
# secrets, but are still kept out of version control by convention.
# iOS uses the "iOS" OAuth client type (reversed-client-id redirect scheme).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android uses the "Android" OAuth client type (package name + SHA-1;
# redirects via the app's own package-name custom URI scheme instead — see
# lib/services/googleOAuthClient.ts).
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
