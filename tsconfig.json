{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    },
    "strictNullChecks": true
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  "exclude": [
    "node_modules",
    ".expo",
    "convex/__tests__",
    "lib/services/__tests__",
    "tests/convex",
    "modules/expo-google-calendar-auth/src/__tests__"
  ]
}
